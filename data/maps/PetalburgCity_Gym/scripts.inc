	goto_if_set FLAG_DEFEATED_PETALBURG_GYM, PetalburgCity_Gym_EventScript_GymGuidePostVictory
	msgbox PetalburgCity_Gym_Text_GymGuideAdvice, MSGBOX_DEFAULT
	release
	end

PetalburgCity_Gym_EventScript_GymGuidePostVictory::
	msgbox PetalburgCity_Gym_Text_GymGuidePostVictory, MSGBOX_DEFAULT
	release
	end

PetalburgCity_Gym_EventScript_LeftGymStatue::
	lockall
	goto_if_set FLAG_BADGE05_GET, PetalburgCity_Gym_EventScript_GymStatueCertified
	goto PetalburgCity_Gym_EventScript_GymStatue
	end

PetalburgCity_Gym_EventScript_RightGymStatue::
	lockall
	goto_if_set FLAG_BADGE05_GET, PetalburgCity_Gym_EventScript_GymStatueCertified
	goto PetalburgCity_Gym_EventScript_GymStatue
	end

PetalburgCity_Gym_EventScript_GymStatueCertified::
	msgbox PetalburgCity_Gym_Text_GymStatueCertified, MSGBOX_DEFAULT
	releaseall
	end

PetalburgCity_Gym_EventScript_GymStatue::
	msgbox PetalburgCity_Gym_Text_GymStatue, MSGBOX_DEFAULT
	releaseall
	end

PetalburgCity_Gym_Text_DadYoureHereWithYourPokemon:
	.string "PAPA: Hm?\p"
	.string "Hé, daar is {PLAYER}!\n"
	.string "Zijn jullie klaar met verhuizen?\p"
	.string "Wat knap dat je helemaal\n"
	.string "zelf hierheen bent gekomen!\p"
	.string "O, ik zie het al.\n"
	.string "Je hebt een Pokémon bij je.\p"
	.string "Dan word je dus net als ik\n"
	.string "een trainer, {PLAYER}.\p"
	.string "Wat geweldig!\n"
	.string "Ik kijk ernaar uit!$"

PetalburgCity_Gym_Text_WallyIdLikeAPokemon:
	.string "Eh... Ik...\n"
	.string "Ik wil graag een Pokémon...$"

PetalburgCity_Gym_Text_DadOhYoureWallyRight:
	.string "PAPA: Hm? Jij bent...\n"
	.string "O ja, jij bent WALLY, toch?$"

PetalburgCity_Gym_Text_WallyIveNeverCaughtAPokemon:
	.string "WALLY: Ik ga bij familie\n"
	.string "in VERDANTURF TOWN logeren.\p"
	.string "Ik dacht dat ik me daar alleen\n"
	.string "zou voelen zonder Pokémon.\p"
	.string "Maar ik heb er nog nooit\n"
	.string "eentje gevangen. Hoe moet dat?$"

PetalburgCity_Gym_Text_DadHmISee:
	.string "PAPA: Hm. Ik begrijp het.$"

PetalburgCity_Gym_Text_DadPlayerGoWithWally:
	.string "PAPA: {PLAYER}, hoorde je dat?\p"
	.string "Ga met WALLY mee en zorg dat\n"
	.string "hij veilig een Pokémon vangt.$"

PetalburgCity_Gym_Text_IllLoanYouMyZigzagoon:
	.string "WALLY, je mag mijn Pokémon lenen.\p"
	.string "WALLY krijgt een ZIGZAGOON!$"

PetalburgCity_Gym_Text_WallyThankYouAndDadGivesPokeBall:
	.string "WALLY: Wauw! Een Pokémon!\p"
	.string "PAPA: Je krijgt ook een POKé BALL.\n"
	.string "Veel succes!\p"
	.string "WALLY krijgt een POKé BALL!$"

PetalburgCity_Gym_Text_WallyOhWowThankYou:
	.string "WALLY: Wauw!\n"
	.string "Dank je wel!$"

PetalburgCity_Gym_Text_WouldYouReallyComeWithMe:
	.string "{PLAYER}... Wil je echt\n"
	.string "met me meegaan?$"

PetalburgCity_Gym_Text_DadSoDidItWorkOut:
	.string "PAPA: Nou, is het gelukt?$"

PetalburgCity_Gym_Text_WallyThankYouBye:
	.string "WALLY: Ja, bedankt!\n"
	.string "Hier is je Pokémon terug.\p"
	.string "{PLAYER}, bedankt dat je\n"
	.string "met me meeging.\p"
	.string "Dankzij jullie heb ik mijn\n"
	.string "eigen Pokémon gevangen!\p"
	.string "Ik beloof dat ik heel goed\n"
	.string "voor hem zal zorgen.\p"
	.string "O! Mama wacht op me.\n"
	.string "Ik moet gaan!\p"
	.string "Doei, {PLAYER}!$"

PetalburgCity_Gym_Text_DadGoCollectBadges:
	.string "PAPA: Nou...\p"
	.string "{PLAYER}, wil je een sterke\n"
	.string "trainer worden? Luister dan.\p"
	.string "Ga naar RUSTBORO CITY,\n"
	.string "voorbij deze stad.\p"
	.string "Daag daar GYM LEADER ROXANNE\n"
	.string "uit voor een duel.\p"
	.string "Bezoek daarna andere GYMS\n"
	.string "en versla hun LEADERS.\p"
	.string "Verzamel hun BADGES, goed?\p"
	.string "Ik ben natuurlijk ook\n"
	.string "een GYM LEADER.\p"
	.string "Ooit vechten wij tegen elkaar,\n"
	.string "{PLAYER}.\p"
	.string "Maar eerst moet je sterker worden.$"

PetalburgCity_Gym_Text_NormanGoToRustboro:
	.string "PAPA: Hm? Ga je niet naar\n"
	.string "de GYM in RUSTBORO CITY?\p"
	.string "Een beginnende trainer is\n"
	.string "voor mij nog geen uitdaging.\p"
	.string "Ik wil dat je me uitdaagt\n"
	.string "als je veel sterker bent.\p"
	.string "Met vier GYM BADGES mag je\n"
	.string "tegen me vechten, {PLAYER}!$"

PetalburgCity_Gym_Text_NormanGoToDewford:
	.string "PAPA: Zo, je hebt de GYM LEADER\n"
	.string "in RUSTBORO CITY verslagen.\p"
	.string "Maar er zijn nog veel trainers\n"
	.string "sterker dan jij, {PLAYER}.\p"
	.string "Aan de overkant van de zee,\n"
	.string "in DEWFORD TOWN, zit BRAWLY.\p"
	.string "Daag hem maar eens uit!$"

PetalburgCity_Gym_Text_YouHaveGottenStronger:
	.string "PAPA: Hm... {PLAYER}, je bent\n"
	.string "sterker geworden.\p"
	.string "Dat zie ik aan de BADGES\n"
	.string "die je hebt verdiend.$"

PetalburgCity_Gym_Text_NormanIntro:
	.string "PAPA: Hm...\n"
	.string "Je hebt dus vier GYM BADGES.\p"
	.string "Zoals beloofd houden we nu\n"
	.string "een Pokémon-duel.\p"
	.string "{PLAYER}...\p"
	.string "Ik ben zo blij dat ik met mijn\n"
	.string "eigen kind een duel kan houden.\p"
	.string "Maar een duel is een duel!\p"
	.string "Als GYM LEADER doe ik alles\n"
	.string "wat ik kan om te winnen.\p"
	.string "{PLAYER}, geef jij ook alles\n"
	.string "wat je in je hebt!$"

PetalburgCity_Gym_Text_NormanDefeat:
	.string "...\p"
	.string "Ik... Ik kan het niet geloven.\p"
	.string "Heb ik echt van {PLAYER} verloren?\p"
	.string "Maar regels zijn regels!\n"
	.string "Hier, pak aan.$"

PetalburgCity_Gym_Text_ReceivedBalanceBadge:
	.string "{PLAYER} krijgt de BALANCE BADGE\n"
	.string "van PAPA!$"

PetalburgCity_Gym_Text_ExplainBalanceBadgeTakeThis:
	.string "PAPA: Met die BADGE stijgt de\n"
	.string "DEFENSE van al je Pokémon.\p"
	.string "Met de HM-aanval SURF kunnen\n"
	.string "Pokémon je over water brengen.\p"
	.string "Hier is mijn cadeau voor jou.\n"
	.string "Ik weet dat je het goed gebruikt.$"

PetalburgCity_Gym_Text_ExplainFacade:
	.string "PAPA: TM42 bevat FACADE.\p"
	.string "De aanval wordt dubbel zo sterk\n"
	.string "als je Pokémon poisoned,\l"
	.string "paralyzed of burned is.\p"
	.string "Zo kun je een nadeel\n"
	.string "in een voordeel veranderen.$"

PetalburgCity_Gym_Text_DadHappyAndSad:
	.string "PAPA: Als GYM LEADER baal ik\n"
	.string "enorm dat ik verloren heb...\p"
	.string "Maar als vader ben ik blij\n"
	.string "en ook een beetje verdrietig.\p"
	.string "Wat vreemd, hè?$"

PetalburgCity_Gym_Text_PleaseComeWithMe:
	.string "Ah, daar ben je, {PLAYER}!\p"
	.string "Kom even met me mee.\n"
	.string "Ik heb iets voor je.$"

PetalburgCity_Gym_Text_LetMeBorrowPlayer:
	.string "NORMAN, vind je het goed\n"
	.string "als {PLAYER} even met me meegaat?$"

PetalburgCity_Gym_Text_DadGoingToKeepTraining:
	.string "PAPA: {PLAYER}, ga af en toe\n"
	.string "even bij mama langs.\p"
	.string "Ik blijf hier extra hard trainen.\p"
	.string "Als trainer wil ik natuurlijk\n"
	.string "ooit meer van je verliezen!$"

PetalburgCity_Gym_Text_DadNoAmountOfTrainingIsEnough:
	.string "PAPA: {PLAYER}, hoe gaat het?\p"
	.string "De wereld van Pokémon is\n"
	.string "ontzettend groot.\p"
	.string "Volgens mij kun je nooit\n"
	.string "genoeg trainen.$"

PetalburgCity_Gym_Text_GymGuideAdvice:
	.string "Hé, hoe gaat het met onze\n"
	.string "toekomstige CHAMPION {PLAYER}?\p"
	.string "De deuren gaan open als je\n"
	.string "de trainers erachter verslaat.\p"
	.string "Oeps, deze deuren zijn al open.\n"
	.string "Dus val mij maar niet aan!\p"
	.string "De trainers hier gebruiken\n"
	.string "allerlei items.\p"
	.string "Links is de SPEED ROOM.\n"
	.string "Rechts is de ACCURACY ROOM.\p"
	.string "De naam staat op elke deur.\n"
	.string "Kies dus goed!\p"
	.string "Heb je gekozen? Veel succes!$"

PetalburgCity_Gym_Text_GymGuidePostVictory:
	.string "{PLAYER}! Wauw! Je hebt zelfs\n"
	.string "je eigen vader verslagen!\p"
	.string "Wat een geweldige prestatie!$"

PetalburgCity_Gym_Text_RandallIntro:
	.string "Eerder aanvallen dan je\n"
	.string "tegenstander...\p"
	.string "Dat geeft me al een groot\n"
	.string "voordeel, vind je niet?$"

PetalburgCity_Gym_Text_RandallDefeat:
	.string "Dat was een geweldig duel!$"

PetalburgCity_Gym_Text_RandallPostBattle:
	.string "Ga naar de volgende kamer\n"
	.string "voor een nieuwe uitdaging.\p"
	.string "Links is de CONFUSION ROOM.\n"
	.string "Rechts is de DEFENSE ROOM.$"

PetalburgCity_Gym_Text_RandallPostBadge:
	.string "Of je nu wint of verliest,\n"
	.string "blijf altijd jezelf en je\l"
	.string "Pokémon trainen.\p"
	.string "Dat is volgens mij wat een\n"
	.string "GYM LEADER moet doen.$"

PetalburgCity_Gym_Text_ParkerIntro:
	.string "Dit is de CONFUSION ROOM.\p"
	.string "Laat eens zien hoe sterk\n"
	.string "jullie band is!$"

PetalburgCity_Gym_Text_ParkerDefeat:
	.string "Ik kon je team niet genoeg\n"
	.string "in de war brengen...\p"
	.string "Jullie hebben een sterke band.$"

PetalburgCity_Gym_Text_ParkerPostBattle:
	.string "Hierna komt de STRENGTH ROOM.\n"
	.string "Kun je brute kracht aan?$"

PetalburgCity_Gym_Text_ParkerPostBadge:
	.string "Sinds je onze LEADER versloeg,\n"
	.string "trainen we veel harder.$"

PetalburgCity_Gym_Text_GeorgeIntro:
	.string "Net als je denkt te winnen,\n"
	.string "herstelt je tegenstander HP...\p"
	.string "Kun je je voorstellen\n"
	.string "hoe vervelend dat is?\p"
	.string "Ik zal het je laten voelen!$"

PetalburgCity_Gym_Text_GeorgeDefeat:
	.string "Ik kon niet genoeg HP herstellen.\n"
	.string "Wat een enorme ATTACK!$"

PetalburgCity_Gym_Text_GeorgePostBattle:
	.string "Dat had ik kunnen verwachten\n"
	.string "van het kind van onze LEADER.\p"
	.string "Nee, wacht! Een trainer wordt\n"
	.string "alleen beter door hard te werken.\p"
	.string "Ik heb zelf niet genoeg geoefend.\p"
	.string "Ga door naar de ONE-HIT KO ROOM.$"

PetalburgCity_Gym_Text_GeorgePostBadge:
	.string "Ik blijf trainen in GYMS.\n"
	.string "Ooit word ik zelf een LEADER.$"

PetalburgCity_Gym_Text_BerkeIntro:
	.string "Ik doe niet rustig aan omdat\n"
	.string "je onze LEADER als vader hebt.\p"
	.string "Ik laat je zien hoe vervelend\n"
	.string "een critical hit kan zijn!$"

PetalburgCity_Gym_Text_BerkeDefeat:
	.string "Jouw kracht...\n"
	.string "Jij bent echt goed.$"

PetalburgCity_Gym_Text_BerkePostBattle:
	.string "Je vader is heel sterk.\n"
	.string "Ik heb veel respect voor hem.\p"
	.string "Ik zie dezelfde kracht in jou.\p"
	.string "Ik hoop dat jullie een\n"
	.string "fantastisch duel houden!$"

PetalburgCity_Gym_Text_BerkePostBadge:
	.string "Sinds je vader onze LEADER is,\n"
	.string "zijn de trainers in PETALBURG\l"
	.string "veel sterker geworden.$"

PetalburgCity_Gym_Text_MaryIntro:
	.string "Hihi...\n"
	.string "Dit is de ACCURACY ROOM.\p"
	.string "Vervelend als elke aanval\n"
	.string "altijd raak is, hè?$"

PetalburgCity_Gym_Text_MaryDefeat:
	.string "Jij was duidelijk beter...$"

PetalburgCity_Gym_Text_MaryPostBattle:
	.string "Er wachten nog sterkere trainers.\p"
	.string "Links is de DEFENSE ROOM.\n"
	.string "Rechts is de RECOVERY ROOM.\p"
	.string "Bij allebei wordt de ATTACK\n"
	.string "van je Pokémon getest.$"

PetalburgCity_Gym_Text_MaryPostBadge:
	.string "Weet je wat wij als trainers\n"
	.string "willen bereiken?\p"
	.string "We willen de allerbeste vrienden\n"
	.string "van onze Pokémon worden.$"

PetalburgCity_Gym_Text_AlexiaIntro:
	.string "Hoe hoger mijn DEFENSE,\n"
	.string "hoe brutaler ik kan aanvallen.$"

PetalburgCity_Gym_Text_AlexiaDefeat:
	.string "Onze DEFENSE was niet genoeg...$"

PetalburgCity_Gym_Text_AlexiaPostBattle:
	.string "Je hebt me iets belangrijks\n"
	.string "geleerd.\p"
	.string "Links is de STRENGTH ROOM.\n"
	.string "Rechts is de ONE-HIT KO ROOM.\p"
	.string "In beide kamers staan trainers\n"
	.string "die goed kunnen aanvallen.$"

PetalburgCity_Gym_Text_AlexiaPostBadge:
	.string "Hoi! Heb je SURF al geprobeerd?$"

PetalburgCity_Gym_Text_JodyIntro:
	.string "Onze GYM LEADER zei dat we\n"
	.string "alles moeten geven om te winnen.\p"
	.string "Ook al ben jij zijn kind!$"

PetalburgCity_Gym_Text_JodyDefeat:
	.string "Maar... Ik gaf alles!$"

PetalburgCity_Gym_Text_JodyPostBattle:
	.string "De manier waarop je vecht...\n"
	.string "Net als je vader!\p"
	.string "Ga maar door! Je vader,\n"
	.string "de GYM LEADER, wacht op je!$"

PetalburgCity_Gym_Text_JodyPostBadge:
	.string "Je Pokémon sterker maken\n"
	.string "is natuurlijk belangrijk.\p"
	.string "Maar wat bepaalt wie wint?\p"
	.string "De band tussen trainers\n"
	.string "en hun Pokémon!$"

PetalburgCity_Gym_Text_DoorAppearsLocked:
	.string "Deze deur lijkt nu\n"
	.string "op slot te zitten...$"

PetalburgCity_Gym_Text_EnterSpeedRoom:
	.string "Op het bord staat SPEED ROOM.\p"
	.string "Wil je naar binnen?$"

@ Unused
PetalburgCity_Gym_Text_DoorAppearsLocked2:
	.string "Deze deur lijkt nu\n"
	.string "op slot te zitten...$"

PetalburgCity_Gym_Text_EnterAccuracyRoom:
	.string "Op het bord staat ACCURACY ROOM.\p"
	.string "Wil je naar binnen?$"

PetalburgCity_Gym_Text_EnterConfusionRoom:
	.string "Op het bord staat CONFUSION ROOM.\p"
	.string "Wil je naar binnen?$"

PetalburgCity_Gym_Text_EnterDefenseRoom:
	.string "Op het bord staat DEFENSE ROOM.\p"
	.string "Wil je naar binnen?$"

PetalburgCity_Gym_Text_EnterRecoveryRoom:
	.string "Op het bord staat RECOVERY ROOM.\p"
	.string "Wil je naar binnen?$"

PetalburgCity_Gym_Text_EnterStrengthRoom:
	.string "Op het bord staat STRENGTH ROOM.\p"
	.string "Wil je naar binnen?$"

PetalburgCity_Gym_Text_EnterOHKORoom:
	.string "Op het bord staat ONE-HIT KO ROOM.\p"
	.string "Wil je naar binnen?$"

PetalburgCity_Gym_Text_EnterGymLeadersRoom:
	.string "GYM LEADER'S ROOM\p"
	.string "Ontdek zelf welke Pokémon\n"
	.string "op je wachten!\p"
	.string "Wil je naar binnen?$"

PetalburgCity_Gym_Text_GymStatue:
	.string "PETALBURG CITY POKéMON GYM$"

PetalburgCity_Gym_Text_GymStatueCertified:
	.string "PETALBURG CITY POKéMON GYM\p"
	.string "NORMAN'S ERKENDE TRAINERS:\n"
	.string "{PLAYER}$"

PetalburgCity_Gym_Text_NormanPreRematch:
	.string "PAPA: {PLAYER}...\n"
	.string "Ik dacht al dat je zou komen.\p"
	.string "Ik zal nooit een uitdaging\n"
	.string "van jou weigeren.\p"
	.string "Dat begrijp je toch?\p"
	.string "In de GYM maakt het niet uit\n"
	.string "dat we vader en kind zijn.\p"
	.string "Nee, juist daarom moeten we\n"
	.string "allebei ons uiterste best doen.\p"
	.string "Toch, {PLAYER}?$"

PetalburgCity_Gym_Text_NormanRematchDefeat:
	.string "Eh... Haha...\n"
	.string "Misschien ging ik iets te hard...$"

PetalburgCity_Gym_Text_NormanPostRematch:
	.string "PAPA: {PLAYER}...\n"
	.string "Wat is jouw droom?\p"
	.string "Mijn droom...\n"
	.string "Hahaha...\l"
	.string "Die is eigenlijk al uitgekomen.$"

PetalburgCity_Gym_Text_NormanRematchNeedTwoMons:
	.string "PAPA: {PLAYER}...\n"
	.string "Ik dacht al dat je zou komen.\p"
	.string "Ik zal nooit een uitdaging\n"
	.string "van jou weigeren.\p"
	.string "Dat begrijp je toch?\p"
	.string "In de GYM maakt het niet uit\n"
	.string "dat we vader en kind zijn.\p"
	.string "Hm? Wacht even, {PLAYER}.\p"
	.string "Heb je maar één Pokémon\n"
	.string "die kan vechten?\p"
	.string "Sorry, kom terug met minstens\n"
	.string "twee Pokémon die kunnen vechten.$"

